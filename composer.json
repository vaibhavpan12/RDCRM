{
  "name": "rd10/production-inventory-crm",
  "description": "RD-10 Production & Material Inventory CRM",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.1",
    "ext-intl": "*",
    "ext-mbstring": "*",
    "ext-mysqli": "*",
    "codeigniter4/framework": "4.6.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Config\\": "app/Config/"
    },
    "exclude-from-classmap": [
      "**/Database/Migrations/**"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  }
}